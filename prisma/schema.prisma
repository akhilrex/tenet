generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id                   String    @id @default(uuid())
  title                String
  notes                String?
  estimatedMinutes     Int       @default(30)
  scheduledDate        String?   // YYYY-MM-DD
  scheduledStartTime   String?   // HH:MM
  isCompleted          Boolean   @default(false)
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  tagId                String?
  tag                  Tag?      @relation(fields: [tagId], references: [id])

  // Recurring task link
  recurringTemplateId  String?
  recurringDate        String?   // The specific occurrence date this was materialized for
}

model Tag {
  id                     String                   @id @default(uuid())
  name                   String                   @unique
  color                  String                   // Hex or predefined color name
  createdAt              DateTime                 @default(now())
  tasks                  Task[]
  recurringTaskTemplates RecurringTaskTemplate[]
}

model RecurringTaskTemplate {
  id                 String    @id @default(uuid())
  title              String
  notes              String?
  estimatedMinutes   Int       @default(30)
  scheduledStartTime String    // HH:MM
  frequency          String    // "daily" | "weekly" | "monthly"
  daysOfWeek         String?   // For weekly: comma-separated "0,1,3" (0=Sun,...,6=Sat)
  dayOfMonth         Int?      // For monthly: 1-31
  interval           Int       @default(1) // every N days/weeks/months
  startDate          String    // YYYY-MM-DD
  endDate            String?   // YYYY-MM-DD or null = forever
  tagId              String?
  tag                Tag?      @relation(fields: [tagId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model SentNotification {
  id        String   @id @default(uuid())
  externalId String  @unique // task id or gcal event id
  sentAt    DateTime @default(now())
}
